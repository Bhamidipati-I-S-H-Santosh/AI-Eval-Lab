{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv-local/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "-q"],
  "python.envFile": "${workspaceFolder}/.env",
  "files.exclude": {
    "**/__pycache__": true,
    ".pytest_cache": true,
    ".evalkit_cache": true
  },
  "python.terminal.useEnvFile": true
}
